{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fanwaave/fanwaave-interfaces/schema/v1/notificationdispatch.json",
  "title": "NotificationDispatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "payload"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "description": "Stable idempotency key for the dispatch."
    },
    "revision": {
      "const": "fanwaave-0002"
    },
    "payload": {
      "$ref": "../../schemas/contact-delivery.schema.json#/$defs/enqueueJob"
    }
  }
}
