{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fanwaave.github.io/contracts/fanwaave-config/v1/authored.schema.json",
  "$defs": {
    "FanwaaveMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FanwaaveMode",
      "type": "string",
      "enum": ["client", "server", "hybrid"]
    },
    "EnvKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EnvKind",
      "type": "string",
      "enum": ["string", "bool", "integer", "double", "json", "url"]
    },
    "Flags2EnvPrecedence": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Flags2EnvPrecedence",
      "type": "string",
      "enum": ["argv-over-env"]
    },
    "Flags2EnvConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Flags2EnvConfig",
      "type": "object",
      "properties": {
        "contract": { "type": "string", "minLength": 1, "maxLength": 256 },
        "require_audit": { "type": "boolean" },
        "precedence": { "$ref": "Flags2EnvPrecedence" }
      },
      "required": ["contract", "require_audit", "precedence"],
      "unevaluatedProperties": false
    },
    "EnvBinding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EnvBinding",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "kind": { "$ref": "EnvKind" },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "default": { "type": "string", "maxLength": 8192 },
        "description": { "type": "string", "maxLength": 512 }
      },
      "required": ["name", "key", "kind", "required", "secret"],
      "unevaluatedProperties": false
    },
    "FanwaaveClientConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FanwaaveClientConfig",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "api_base_url_binding": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tenant_id_binding": { "type": "string", "minLength": 1, "maxLength": 64 },
        "auth_token_binding": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["enabled"],
      "unevaluatedProperties": false
    },
    "FanwaaveServerConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FanwaaveServerConfig",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "bind_addr_binding": { "type": "string", "minLength": 1, "maxLength": 64 },
        "database_url_binding": { "type": "string", "minLength": 1, "maxLength": 64 },
        "push_provider_binding": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["enabled"],
      "unevaluatedProperties": false
    },
    "FanwaaveConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FanwaaveConfig",
      "type": "object",
      "properties": {
        "version": { "type": "integer", "minimum": 1, "maximum": 1 },
        "mode": { "$ref": "FanwaaveMode" },
        "strict": { "type": "boolean" },
        "flags2env": { "$ref": "Flags2EnvConfig" },
        "env": { "type": "array", "items": { "$ref": "EnvBinding" } },
        "client": { "$ref": "FanwaaveClientConfig" },
        "server": { "$ref": "FanwaaveServerConfig" }
      },
      "required": ["version", "mode", "strict", "flags2env", "env"],
      "unevaluatedProperties": false
    }
  }
}
